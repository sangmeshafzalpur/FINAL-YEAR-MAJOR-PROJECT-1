# backend/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# ChilliFusionNet Backend — Environment Variables Template
#
# USAGE:
#   Copy this file to backend/.env for local development:
#     cp backend/.env.example backend/.env
#   Then fill in your values.
#
# NOTE: .env is listed in .gitignore and will NEVER be committed to Git.
#       Set these same variables in Render → Environment Variables for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev: use * (allows all origins)
# Production: use your exact Netlify URL, e.g.:
#   CORS_ORIGINS=https://chillifusionnet.netlify.app
CORS_ORIGINS=*

# ── Server port ───────────────────────────────────────────────────────────────
# Render sets $PORT automatically.  For local dev use 8000.
PORT=8000

# ── Model paths (optional — defaults match repo structure) ────────────────────
# Only set these if you move the model file to a non-default location.
# MODEL_PATH=/absolute/path/to/chillifusionnet_final.keras
# CLASS_NAMES_PATH=/absolute/path/to/class_names.json

# ── Storage paths (optional — for Render disk mounts) ────────────────────────
# UPLOAD_DIR=/opt/render/project/src/chillifusionnet_app/backend/uploads
# OUTPUT_DIR=/opt/render/project/src/chillifusionnet_app/backend/outputs

# ── TensorFlow ────────────────────────────────────────────────────────────────
TF_CPP_MIN_LOG_LEVEL=2
TF_FORCE_GPU_ALLOW_GROWTH=true

# ── Python ────────────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
