# frontend/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# ChilliFusionNet Frontend — Environment Variables Template
#
# This frontend is plain HTML/CSS/JS (no bundler/framework).
# There is NO .env file loaded by the browser directly.
#
# Instead, the API URL is configured in:
#   frontend/js/config.js  →  window.__API_BASE_URL
#
# HOW TO CONFIGURE:
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV:
#   Edit frontend/js/config.js and ensure the localhost branch reads:
#     API_BASE_URL = 'http://localhost:8000';
#   (This is already the default — no action needed.)
#
# NETLIFY PRODUCTION:
#   1. Go to Netlify → Site Configuration → Environment Variables.
#   2. Add the variable below with your actual Render service URL.
#   3. Redeploy — Netlify's build step (sed in netlify.toml) will inject it.
#
# ─────────────────────────────────────────────────────────────────────────────

# Your Render backend URL (set this in Netlify dashboard, NOT in a committed file)
API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
